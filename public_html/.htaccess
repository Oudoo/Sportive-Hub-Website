# Sportive Hub on Hostinger (LiteSpeed, reads Apache rules).
# Forces HTTPS and serves short URLs: /links and /where-it-hurts instead of the .html names.

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always use HTTPS.
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # /index.html -> /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [L,R=301]

  # /links.html -> /links, so each page has one address.
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301,NE]

  # /links/ -> /links
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # /links serves links.html without changing the address.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>
