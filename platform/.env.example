# Copy to .env for local development. On Hostinger, set these as the website's
# environment variables (hPanel -> Websites -> Manage -> Node.js -> Environment variables).

# MySQL connection. Hostinger fills this in automatically when you attach a database to the app.
DATABASE_URL="mysql://sportive:sportive-dev-pass@localhost:3306/sportive_hub"

# Signs session tokens. Use at least 32 random characters, e.g. `openssl rand -base64 48`.
# Changing it signs everyone out.
AUTH_SECRET="replace-me-with-at-least-32-random-characters"

# Public address of this app, used in referral links.
APP_URL="http://localhost:3000"

# First admin account, created by `npx prisma db seed` if it does not exist yet.
ADMIN_EMAIL="admin@sportive-hub.com"
ADMIN_PASSWORD="change-this-password"
ADMIN_NAME="Sportive Hub Admin"

# Set to 1 to also seed demo patients, sessions and updates (never in production).
SEED_DEMO="0"
